# Copia este archivo como .env (no subas el .env a GitHub)
DATABASE_URL=postgresql+psycopg://prevenapp:prevenapp@db:5432/prevenapp
# Clave secreta para firmar los tokens de inicio de sesión. Cámbiala por una frase larga.
SECRET_KEY=cambia-esta-clave-por-una-frase-larga-y-secreta

# Correo para los avisos (con Docker ya se usa Mailpit automáticamente)
# SMTP_HOST=smtp.tuempresa.es
# SMTP_PORT=587
# SMTP_USUARIO=
# SMTP_PASSWORD=
# SMTP_TLS=true
# AVISOS_REMITENTE=avisos@tuempresa.es
# Si lo dejas vacío, se avisa a todos los usuarios con rol "presupuestos"
# AVISOS_DESTINATARIOS=presupuestos@tuempresa.es
